# Supabase Configuration
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SUPABASE_SERVICE_ROLE_KEY é utilizada APENAS pelo Supabase CLI e Edge Functions.
# NÃO use prefixo VITE_ -- caso contrário o Vite injeta a chave no bundle do navegador,
# expondo o banco inteiro a qualquer visitante. Obtenha-a em:
# Supabase Dashboard → Settings → API → service_role key (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# N8N Webhook Configuration
VITE_N8N_WEBHOOK_URL=https://fernandocosta.app.n8n.cloud/webhook/novo-cadastro

# Environment
VITE_ENVIRONMENT=development
