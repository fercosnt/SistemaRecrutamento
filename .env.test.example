# Environment Variables para Testes E2E
# Copie este arquivo para .env.test e preencha com suas credenciais de teste

# Credenciais de um candidato de teste válido no banco de dados
# IMPORTANTE: Use um usuário de TESTE, não um usuário real
TEST_USER_EMAIL=fernando@beautysmile.com.br
TEST_USER_PASSWORD=teste123
TEST_USER_NAME=Fernando

# URLs do Supabase (mesmas do .env.local)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Observações:
# 1. Certifique-se de que o usuário de teste existe na tabela auth.users
# 2. O candidato deve ter um registro em public.candidatos com user_id correspondente
# 3. RLS deve estar desabilitado em desenvolvimento OU políticas corretas aplicadas
# 4. Email do candidato de teste NÃO precisa ser confirmado (se confirmação estiver desabilitada)
