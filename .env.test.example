# Environment Variables para Testes E2E
# Copie este arquivo para .env.test e preencha os valores.
#
# ⚠️  CI-08 — credenciais fora do repositório.
#     `.env.test` é gitignored e guarda os VALORES REAIS. Este arquivo
#     (`.env.test.example`) é versionado e documenta apenas as CHAVES — todos os
#     valores abaixo são placeholders vazios. NUNCA escreva um email/senha real
#     aqui. Um guard de CI (src/__tests__/guards/no-hardcoded-test-creds.grep.test.ts)
#     falha o build se uma credencial real reaparecer sob e2e/.

# ─── Candidato de teste (real-auth E2E: login + perfil + candidatura) ───────────
# Um candidato existente em auth.users + public.candidatos (user_id correspondente).
# Consumido por: login-flow, perfil, candidatura-submit, explicacao-flow,
# prova-cognitiva, vagas-browse (B-J04), auth-hydration (SC-2), navegacao.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_NAME=

# ─── Admin / RH de teste (jornadas RH e admin — navegacao.spec.ts) ──────────────
# Conta com role 'administrador' (cobre também o caminho RH — não há conta
# 'recrutador' semeada). Se ausente, navegacao cai para as chaves TEST_USER_*.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# ─── Gating das suítes que exigem auth real ─────────────────────────────────────
# 'true' habilita as suítes real-auth (describeRealAuth). Mantenha VAZIO por padrão
# — o CI roda com estas suítes DESLIGADAS; a ausência NÃO quebra o pipeline.
E2E_AUTH_TEST_USERS=
# IDs de dados semeados para as jornadas do funil RH (navegacao.spec.ts).
E2E_CANDIDATURA_ID=
E2E_VAGA_ID=

# ─── Supabase (mesmas URLs/chave do .env.local) ─────────────────────────────────
# A anon key é pública por design (NÃO é segredo); a URL também não é secreta.
# TEST_SUPABASE_* são lidas pelo ci.yml (têm precedência sobre os placeholders);
# VITE_SUPABASE_* são o que a app lê no client.ts (obrigatórias para o boot).
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Observações:
# 1. O usuário de teste deve existir em auth.users + ter registro em public.candidatos.
# 2. Rode as suítes real-auth com, por exemplo:
#      E2E_AUTH_TEST_USERS=true npx playwright test navegacao
#      E2E_REAL_LOGIN=1 npx playwright test e2e/perfil.spec.ts
# 3. Consulte e2e/README.md para o detalhamento de cada fluxo.
